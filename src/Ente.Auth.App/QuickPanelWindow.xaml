<Window
    x:Class="Ente.Auth.App.QuickPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Padding="18" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowSpacing="12" KeyDown="Root_KeyDown">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="Ente Auth" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                <Button Padding="8" ToolTipService.ToolTip="Lock app" Click="LockApp_Click">
                    <FontIcon Glyph="&#xE72E;" FontSize="14" />
                </Button>
                <Button Padding="10,5" Content="Open app" Click="OpenApp_Click" />
                <Button Padding="8" ToolTipService.ToolTip="Close" Click="ClosePanel_Click">
                    <FontIcon Glyph="&#xE8BB;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>
        <AutoSuggestBox x:Name="SearchBox" Grid.Row="1" Height="42" PlaceholderText="Search codes" QueryIcon="Find"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <ListView Grid.Row="2" ItemsSource="{Binding Codes}" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /></Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Button HorizontalContentAlignment="Stretch" MinHeight="48" Padding="10" Margin="0,1" Background="Transparent" BorderThickness="0"
                            Click="CopyCode_Click" Tag="{Binding}" ToolTipService.ToolTip="Copy code"
                            AutomationProperties.Name="{Binding AutomationName}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="1">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE734;" FontSize="11" Visibility="{Binding IsPinned, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding Issuer}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Text="{Binding AccountName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Width="116" Spacing="5">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                    <TextBlock Text="{Binding Code}" FontFamily="Cascadia Mono" FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CountdownText}" FontSize="11" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <ProgressBar Value="{Binding Progress}" Height="2" Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="No matching codes" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Try another account or open the full app." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Row="3" Spacing="2">
            <TextBlock Text="Windows Hello verified · click a row to copy" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Grid>
</Window>
