<Window
    x:Class="Ente.Auth.App.PresenceFailureWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Padding="24" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel Spacing="14" VerticalAlignment="Center">
            <TextBlock Text="Windows Hello is required" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Verification was cancelled or is unavailable. No authenticator details were shown." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Sign-in options" Click="Settings_Click" />
                <Button Content="Close" Click="Close_Click" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
