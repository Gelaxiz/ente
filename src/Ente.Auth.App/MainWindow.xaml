<Window
    x:Class="Ente.Auth.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!--
        THESIS: Authenticator codes behave like a quiet native instrument, not a dashboard of cards.
        OWN-WORLD: Windows neutrals, crisp separators, Segoe UI, and one Ente-purple timing signal.
        STORY: Search, read the current code, copy it, and return to the interrupted task.
        FIRST VIEWPORT: A compact rail, one search field, and a dense code ledger dominate the window.
        FORM: Native quick-list, established Ente world, key ente-auth-windows-native-list.
        FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
        -->
        <NavigationView x:Name="Navigation"
                        PaneDisplayMode="Top"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Codes" Tag="codes">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid x:Name="CodesSurface" Padding="32,20,36,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="Authenticator codes" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock Text="Unofficial community client" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="BackupProgressPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                <ProgressRing Width="16" Height="16" IsActive="True" />
                                <TextBlock x:Name="BackupProgressText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Style="{StaticResource AccentButtonStyle}" Click="AddCode_Click" Content="Add code" />
                            <DropDownButton Content="More">
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Name="ImportButton" Text="Import codes" Click="Import_Click" />
                                        <MenuFlyoutItem x:Name="ExportButton" Text="Export codes" Click="Export_Click" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>
                    </Grid>

                    <AutoSuggestBox x:Name="SearchBox" Grid.Row="1" Margin="0,22,0,12" Height="44"
                                    PlaceholderText="Search accounts" QueryIcon="Find"
                                    Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Grid.Row="2">
                        <ListView ItemsSource="{Binding Codes}" SelectionMode="None" IsItemClickEnabled="False" Visibility="{Binding IsGridView, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="76" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,10" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Issuer}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding AccountName}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Width="180" VerticalAlignment="Center" Spacing="6">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                                <TextBlock Text="{Binding Code}" FontFamily="Cascadia Mono" FontSize="23" FontWeight="SemiBold" CharacterSpacing="75" />
                                                <TextBlock Text="{Binding CountdownText}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="2" Foreground="{StaticResource AccentBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Width="40" Height="40" Padding="0" ToolTipService.ToolTip="Copy code"
                                                AutomationProperties.Name="{Binding AutomationName}"
                                                Click="CopyCode_Click" Tag="{Binding}">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="15" />
                                        </Button>
                                        <Button Grid.Column="3" Width="40" Height="40" Padding="0" Margin="4,0,0,0"
                                                ToolTipService.ToolTip="More actions" AutomationProperties.Name="More account actions"
                                                Click="MoreActions_Click" Tag="{Binding}">
                                            <FontIcon Glyph="&#xE712;" FontSize="15" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <GridView ItemsSource="{Binding Codes}" SelectionMode="None" IsItemClickEnabled="False" Visibility="{Binding IsGridView, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,10" Margin="4" MinWidth="220" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Issuer}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding AccountName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                                <TextBlock Text="{Binding Code}" FontFamily="Cascadia Mono" FontSize="20" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding CountdownText}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="2" Foreground="{StaticResource AccentBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
                                            <Button Width="36" Height="36" Padding="0" ToolTipService.ToolTip="Copy code" AutomationProperties.Name="{Binding AutomationName}" Click="CopyCode_Click" Tag="{Binding}">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                            </Button>
                                            <Button Width="36" Height="36" Padding="0" ToolTipService.ToolTip="More actions" AutomationProperties.Name="More account actions" Click="MoreActions_Click" Tag="{Binding}">
                                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE8D7;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="No matching codes" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Add an otpauth link or change your search." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Margin="0,0,0,8" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                </Grid>

                <ScrollViewer x:Name="SettingsSurface" Visibility="Collapsed">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left" Padding="32,20,36,36" Spacing="24">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock Text="Window, tray, and privacy behavior" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <ComboBox x:Name="LaunchModePicker" Header="Launch mode" Width="320" HorizontalAlignment="Left" SelectionChanged="LaunchModePicker_SelectionChanged">
                                <ComboBoxItem Content="Show window" />
                                <ComboBoxItem Content="Start minimized" />
                                <ComboBoxItem Content="Tray only" />
                            </ComboBox>
                            <TextBlock Text="Controls how the app appears when Windows starts it." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="LaunchAtSignInToggle" Header="Launch at sign-in" Toggled="LaunchAtSignInToggle_Toggled" />
                        <StackPanel Spacing="10">
                            <TextBlock Text="Ente account" FontWeight="SemiBold" />
                            <TextBlock x:Name="AccountStatusText" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SignInButton" Content="Sign in" Click="SignIn_Click" />
                                <Button x:Name="SyncButton" Content="Sync now" Click="Sync_Click" Visibility="Collapsed" />
                                <Button x:Name="SignOutButton" Content="Sign out" Click="SignOut_Click" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                        <ToggleSwitch x:Name="AppLockToggle" Header="Require app lock" Toggled="AppLockToggle_Toggled" />
                        <ToggleSwitch x:Name="FocusSearchOnOpenToggle" Header="Focus search bar on open" Toggled="FocusSearchOnOpenToggle_Toggled" />
                        <ToggleSwitch x:Name="AutoSyncOnNetworkToggle" Header="Auto-sync when internet is available" Toggled="AutoSyncOnNetworkToggle_Toggled" />
                        <ToggleSwitch x:Name="GridViewLayoutToggle" Header="Use 2-column grid layout (compact)" Toggled="GridViewLayoutToggle_Toggled" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="About" FontWeight="SemiBold" />
                            <TextBlock Text="Ente Auth Community is an unofficial community fork and is not endorsed by Ente." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
